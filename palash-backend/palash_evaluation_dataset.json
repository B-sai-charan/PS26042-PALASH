[
  {
    "id": 1,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को सरकारी योजना का लाभ मिलेगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 2,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान सरकारी योजना के लिए आवेदन कर सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 3,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार किसानों को आर्थिक सहायता प्रदान करेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 4,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "यह योजना छोटे और सीमांत किसानों के लिए है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 5,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को बीज और खाद उपलब्ध कराई जाएगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 6,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को फसल के लिए उचित मूल्य मिलेगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 7,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान अपनी फसल का बीमा करा सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 8,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार किसानों को सिंचाई की सुविधा प्रदान करेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 9,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को कृषि उपकरण खरीदने के लिए सहायता मिलेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 10,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "इस योजना से ग्रामीण किसानों को लाभ होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 11,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकारी योजना के लिए आवेदन करना आवश्यक है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 12,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "इस योजना के लिए कोई शुल्क नहीं लिया जाएगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 13,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "योजना का लाभ सीधे बैंक खाते में मिलेगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 14,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभार्थियों की सूची वेबसाइट पर उपलब्ध है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 15,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन की अंतिम तारीख 30 सितंबर है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 16,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन करने के बाद पंजीकरण संख्या सुरक्षित रखें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 17,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार पात्र लोगों को वित्तीय सहायता देगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 18,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "योजना का लाभ केवल पात्र नागरिकों को मिलेगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 19,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन की स्थिति ऑनलाइन देखी जा सकती है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 20,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "अधिक जानकारी के लिए संबंधित कार्यालय से संपर्क करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 21,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभ प्राप्त करने के लिए आवश्यक दस्तावेज जमा करने होंगे।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 22,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन के साथ आधार कार्ड की प्रति जमा करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 23,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "बैंक खाते की जानकारी देना आवश्यक है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 24,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदक को पहचान प्रमाण प्रस्तुत करना होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 25,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "निवास प्रमाण पत्र आवश्यक है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 26,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान को भूमि से संबंधित दस्तावेज जमा करने होंगे।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 27,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सभी दस्तावेज सही और स्पष्ट होने चाहिए।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 28,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "अधूरे दस्तावेज वाले आवेदन स्वीकार नहीं किए जाएंगे।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 29,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "दस्तावेजों की जांच के बाद आवेदन स्वीकृत होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 30,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन पत्र के साथ पासपोर्ट आकार की फोटो लगाएं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 31,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान अपने नजदीकी कार्यालय में आवेदन कर सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 32,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "ऑनलाइन आवेदन करने के लिए वेबसाइट खोलें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 33,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन पत्र ध्यान से भरें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 34,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "गलत जानकारी देने पर आवेदन रद्द किया जा सकता है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 35,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन जमा करने के बाद रसीद प्राप्त करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 36,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान मोबाइल फोन से आवेदन कर सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 37,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन पूरा होने के बाद एक पुष्टि संदेश मिलेगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 38,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन में अपना मोबाइल नंबर दर्ज करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 39,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन की जानकारी बाद में बदली नहीं जा सकती।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 40,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसी समस्या की स्थिति में हेल्पलाइन पर संपर्क करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 41,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन करने के 30 दिनों के भीतर लाभ मिल सकता है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 42,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "यह योजना 1 जनवरी से लागू होगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 43,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन की अंतिम तारीख 15 अगस्त है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 44,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभार्थी को 5000 रुपये की सहायता मिलेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 45,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार हर महीने आर्थिक सहायता देगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 46,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन की जांच 7 दिनों में पूरी होगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 47,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को 10 किलो बीज उपलब्ध कराया जाएगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 48,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "योजना के तहत 50 प्रतिशत सहायता दी जाएगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 49,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभ की राशि तीन महीने के भीतर प्राप्त होगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 50,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "पंजीकरण सुबह 10 बजे से शुरू होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 51,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकारी अस्पताल में इलाज मुफ्त किया जाएगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 52,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "मरीज को अपना पहचान पत्र साथ लाना होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 53,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "गर्भवती महिलाओं को विशेष स्वास्थ्य सुविधा मिलेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 54,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "बच्चों का टीकाकरण समय पर कराएं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 55,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "स्वास्थ्य केंद्र में डॉक्टर उपलब्ध हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 56,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "जरूरत पड़ने पर मरीज को अस्पताल भेजा जाएगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 57,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार ग्रामीण क्षेत्रों में स्वास्थ्य सेवाएं बढ़ाएगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 58,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "दवा लेने से पहले डॉक्टर की सलाह लें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 59,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "स्वास्थ्य जांच के लिए नजदीकी केंद्र पर जाएं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 60,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आपातकालीन स्थिति में तुरंत अस्पताल जाएं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 61,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "छात्रों को छात्रवृत्ति के लिए आवेदन करना होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 62,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "गरीब परिवारों के बच्चों को शिक्षा सहायता मिलेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 63,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "विद्यालय में प्रवेश के लिए दस्तावेज आवश्यक हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 64,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "छात्र ऑनलाइन छात्रवृत्ति आवेदन कर सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 65,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार छात्रों को किताबें उपलब्ध कराएगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 66,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "विद्यालय में मुफ्त भोजन दिया जाएगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 67,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "छात्रों को परीक्षा की तैयारी समय पर करनी चाहिए।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 68,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "शिक्षकों को प्रशिक्षण दिया जाएगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 69,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "ग्रामीण बच्चों के लिए नई कक्षाएं शुरू की जाएंगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 70,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "शिक्षा योजना का उद्देश्य बच्चों को बेहतर अवसर देना है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 71,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभार्थी के बैंक खाते में राशि भेजी जाएगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 72,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "बैंक खाता आधार कार्ड से जुड़ा होना चाहिए।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 73,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "बैंक में मोबाइल नंबर दर्ज होना आवश्यक है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 74,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान बैंक शाखा में जाकर जानकारी प्राप्त कर सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 75,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "भुगतान की स्थिति ऑनलाइन देखी जा सकती है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 76,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार सीधे लाभार्थी के खाते में पैसा भेजेगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 77,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "बैंक खाते की जानकारी गलत नहीं होनी चाहिए।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 78,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "भुगतान में देरी होने पर कार्यालय से संपर्क करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 79,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभ प्राप्त करने के लिए सक्रिय बैंक खाता आवश्यक है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 80,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "बैंक से संबंधित समस्या के लिए ग्राहक सेवा से संपर्क करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 81,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "ग्रामीण क्षेत्रों के लोगों को यह सेवा उपलब्ध होगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 82,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "नजदीकी पंचायत कार्यालय में जानकारी प्राप्त करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 83,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "गांव में नया सेवा केंद्र खोला गया है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 84,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "नागरिक अपने आवेदन की स्थिति पूछ सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 85,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकार ग्रामीण क्षेत्रों में इंटरनेट सुविधा बढ़ाएगी।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 86,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "पंचायत कार्यालय में आवेदन जमा किया जा सकता है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 87,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सेवा का लाभ लेने के लिए पंजीकरण आवश्यक है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 88,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभार्थी को सही मोबाइल नंबर देना होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 89,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसी भी सहायता के लिए हेल्पलाइन नंबर पर फोन करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 90,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकारी सेवाओं की जानकारी ऑनलाइन उपलब्ध है।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 91,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "लाभ लेने के लिए किसानों को जरूरी कागजात जमा करने होंगे।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 92,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को लाभ पाने के लिए सभी आवश्यक दस्तावेज जमा करने होंगे।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 93,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को योजना का लाभ लेने के लिए जरूरी दस्तावेज प्रस्तुत करने होंगे।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 94,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "जरूरी दस्तावेज जमा करने के बाद ही आवेदन पूरा होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 95,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसान सरकारी सहायता पाने के लिए आवेदन कर सकते हैं।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 96,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सरकारी सहायता के लिए किसानों को आवेदन करना होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 97,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "किसानों को सरकारी मदद प्राप्त करने के लिए पंजीकरण करना होगा।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 98,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "योजना का लाभ पाने के लिए पात्र किसान आवेदन करें।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 99,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "आवेदन करने वाले किसानों को दस्तावेज तैयार रखने चाहिए।",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  },
  {
    "id": 100,
    "source_language": "hin_Deva",
    "target_language": "sat_Olck",
    "source_text": "सभी पात्र किसानों को योजना की जानकारी दी जाएगी.",
    "translated_text": null,
    "quality_score": null,
    "meaning_preserved": null,
    "notes": ""
  }
]